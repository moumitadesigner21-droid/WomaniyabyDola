{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "womania-payments-sandbox",
  "main": "payment-worker.mjs",
  "triggers": { "crons": [] },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "d1_databases": [{ "binding": "DB", "database_name": "womania-payments-sandbox", "database_id": "b877f239-ec7d-4921-b3c7-2240f5946981", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "womania-media" }],
  "unsafe": { "bindings": [
    { "name": "LOGIN_LIMITER", "type": "ratelimit", "namespace_id": "1101", "simple": { "limit": 5, "period": 60 } },
    { "name": "ORDER_LIMITER", "type": "ratelimit", "namespace_id": "1102", "simple": { "limit": 10, "period": 60 } },
    { "name": "QUOTE_LIMITER", "type": "ratelimit", "namespace_id": "1103", "simple": { "limit": 60, "period": 60 } }
  ] },
  "vars": { "SITE_URL": "https://womania-payments-sandbox.karao-digital.workers.dev", "CASHFREE_ENV": "sandbox", "CASHFREE_API_VERSION": "2025-01-01" }
}

# Copy to .dev.vars for local development (read by `next dev` via
# initOpenNextCloudflareForDev and by `wrangler dev`). Never commit .dev.vars.
# In production set each of these with:  npx wrangler secret put <NAME>

# Bootstraps the first admin user on first login; ignored once admin_users has a row.
ADMIN_PASSWORD=change-me

# Signs the admin session cookie. Rotate to log every admin out.
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Optional: separate key for customer (storefront account) sessions. Falls back
# to ADMIN_SESSION_SECRET with a different key prefix.
CUSTOMER_SESSION_SECRET=

# WhatsApp order notifications (at least one channel)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CALLMEBOT_API_KEY=

# Email backup notifications (Resend)
RESEND_API_KEY=
ORDER_EMAIL_FROM=orders@womaniabydola.com

# Cashfree Payments. Use Sandbox credentials locally first.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Cashfree PG webhook signatures use CASHFREE_CLIENT_SECRET (no separate secret).
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
